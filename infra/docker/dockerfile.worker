# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY deploy/worker/package.json ./package.json
COPY deploy/worker/package-lock.json ./package-lock.json
RUN npm ci --no-audit --no-fund

COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json ./
COPY deploy/worker/build-worker.mjs ./deploy/worker/build-worker.mjs

RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" \
    npm run db:generate

COPY worker ./worker
COPY lib ./lib

RUN npm run build


FROM node:22-bookworm-slim AS runtime-dependencies

WORKDIR /app

COPY deploy/worker/runtime/package.json ./package.json
COPY deploy/worker/runtime/package-lock.json ./package-lock.json

RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force


FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS="--enable-source-maps --network-family-autoselection-attempt-timeout=2000"

COPY --from=runtime-dependencies /app/node_modules ./node_modules
COPY --from=runtime-dependencies /app/package.json ./package.json

COPY --from=builder /app/dist/worker.mjs ./dist/worker.mjs
COPY --from=builder /app/dist/worker.mjs.map ./dist/worker.mjs.map

USER node

CMD ["node", "dist/worker.mjs"]