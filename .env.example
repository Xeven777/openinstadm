# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openinstadm
# Use Neon pooled endpoint (…-pooler.neon.tech) so PgBouncer can suspend between polls

# Trigger.dev job runner (https://trigger.dev)
# TRIGGER_PROJECT_REF is used by `npm run trigger:deploy`; the secret key is what
# the web app uses to trigger runs. Set both here for local dev, and in the
# Trigger.dev dashboard for deployed tasks.
TRIGGER_PROJECT_REF=proj_your_project_ref
TRIGGER_SECRET_KEY=tr_dev_your_secret_key

# Auth — OAuth (primary, no domain needed). Set at least one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
# Optional: magic-link email via Resend (needs verified domain). Omit to hide email form.
# RESEND_API_KEY=re_...
# EMAIL_FROM=OpenInstaDM <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# AI DM replies (global key, DM-only auto-send). Omit to disable the AI tier —
# fallback inbox rule keeps working without it.
AI_API_KEY=sk-...
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BUDGET_PER_HOUR=100
