# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openinstadm
# Use Neon pooled endpoint (…-pooler.neon.tech) so PgBouncer can suspend between polls
REDIS_URL=redis://localhost:6379
# Worker tuning for Neon free tier — increase to 30m for lowest CU, 0 to disable polling
# COMMENT_POLL_INTERVAL_MS=900000
# COMMENT_POLL_DISABLED=false
# DATABASE_POOL_MAX=10          # web=10, worker set to 3 on GCP
# DATABASE_IDLE_TIMEOUT_MS=10000

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenInstaDM <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
